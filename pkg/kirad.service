[Unit]
Description=kirad - A KIRA routing daemon written in Rust
After=network.target
Before=network-online.target

[Service]
Environment=RUST_LOG="debug"
ExecStart=/usr/local/bin/kirad -n /usr/local/share/kira/nftables.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
ProtectSystem=full

[Install]
WantedBy=multi-user.target
